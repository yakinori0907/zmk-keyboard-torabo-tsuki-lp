#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMP          CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BKQUOTE      LEFT_BRACE        // `
#define JP_UNDSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

/ {
    combos {
        compatible = "zmk,combos";

        mo_bt_layer1 {
            bindings = <&mo 6>;
            key-positions = <57 58>;
        };

        mo_bt_layer2 {
            bindings = <&mo 6>;
            key-positions = <59 60>;
        };

        kp_esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
            timeout-ms = <120>;
        };

        kp_tab {
            bindings = <&kp TAB>;
            key-positions = <25 26>;
            timeout-ms = <120>;
        };
    };

    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";            // 判定ロジックをbalancedに
            tapping-term-ms = <280>;        // 判定時間
            quick-tap-ms = <175>;           // 連打時はタップを優先
            require-prior-idle-ms = <150>;  // タイピングが止まった時だけホールドを許可
            bindings = <&kp>, <&kp>;
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        td_bs_del: td_bs_del {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BS_DEL";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DELETE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0:default_layer

        default {
            bindings = <
&none  &none         &none     &none     &none   &none                                     &none        &none  &none      &none     &none             &none
&none  &kp Q         &kp W     &kp E     &kp R   &kp T                                     &kp Y        &kp U  &kp I      &kp O     &kp P             &none
&none  &kp A         &kp S     &kp D     &kp F   &kp G        &none            &none       &kp H        &kp J  &kp K      &kp L     &lt 5 MINUS       &none
&none  &mt LSHIFT Z  &kp X     &kp C     &kp V   &kp B        &trans           &trans      &kp N        &kp M  &kp COMMA  &kp DOT   &mt RSHIFT SLASH  &none
&none  &kp LCTRL     &kp LGUI  &kp LALT  &trans  &lt 2 SPACE  &lt 3 JP_HANZEN  &td_bs_del  &lt 4 ENTER  &none  &none      &kp LEFT  &kp RIGHT         &none
            >;
        };

        // 1:mouse_layer

        mouse {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none         &none          &none     &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &kp LA(LEFT)  &kp LA(RIGHT)  &trans    &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &mkp MB1      &mkp MB2       &mkp MB3  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans         &trans    &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none         &none          &trans    &trans  &none
            >;
        };

        // 2:mark_layer

        mark {
            bindings = <
&none  &none            &none          &none     &none       &none                                   &none           &none         &none            &none            &none                   &none
&none  &kp EXCLAMATION  &kp JP_DQUOTE  &kp HASH  &kp DOLLAR  &kp PERCENT                             &kp JP_AMP      &kp JP_QUOTE  &kp JP_LPAREN    &kp JP_RPAREN    &kp JP_YEN              &none
&none  &trans           &trans         &trans    &trans      &trans       &none          &none       &kp JP_BKQUOTE  &kp JP_TILDE  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_AT               &none
&none  &trans           &trans         &trans    &trans      &trans       &trans         &trans      &kp JP_CARET    &kp JP_PIPE   &kp JP_LBRACE    &kp JP_RBRACE    &mt RSHIFT JP_UNDSCORE  &none
&none  &kp LCTRL        &kp LGUI       &kp LALT  &trans      &kp SPACE    &kp JP_HANZEN  &td_bs_del  &kp ENTER       &none         &none            &kp JP_COLON     &kp SEMICOLON           &none
            >;
        };

        // 3:number_layer

        number {
            bindings = <
&none  &none      &none     &none     &none   &none                                 &none         &none         &none         &none         &none                   &none
&none  &trans     &trans    &trans    &trans  &trans                                &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SPACE     &kp JP_PLUS             &none
&none  &trans     &trans    &trans    &trans  &trans     &none          &none       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp JP_EQUAL  &kp MINUS               &none
&none  &trans     &trans    &trans    &trans  &trans     &trans         &td_bs_del  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT       &mt RSHIFT JP_ASTERISK  &none
&none  &kp LCTRL  &kp LGUI  &kp LALT  &trans  &kp SPACE  &kp JP_HANZEN  &kp ENTER   &kp NUMBER_0  &none         &none         &kp COMMA     &kp SLASH               &none
            >;
        };

        // 4:function_layer

        function {
            bindings = <
&none  &none       &none     &none     &none    &none                                 &none      &none         &none        &none          &none          &none
&none  &kp F1      &kp F2    &kp F3    &kp F4   &kp F5                                &trans     &kp HOME      &kp UP       &kp END        &kp PAGE_UP    &none
&none  &kp F6      &kp F7    &kp F8    &kp F9   &kp F10    &none          &none       &trans     &kp LEFT      &kp DOWN     &kp RIGHT      &kp PAGE_DOWN  &none
&none  &kp LSHIFT  &none     &none     &kp F11  &kp F12    &trans         &trans      &trans     &kp LG(LEFT)  &kp LG(TAB)  &kp LG(RIGHT)  &trans         &none
&none  &kp LCTRL   &kp LGUI  &kp LALT  &trans   &kp SPACE  &kp JP_HANZEN  &td_bs_del  &kp ENTER  &trans        &none        &none          &trans         &none
            >;
        };

        // 5:scroll_layer

        scroll {
            bindings = <
&none  &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none
&none  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &none
            >;
        };

        // 6:bt_layer

        bluetooth {
            bindings = <
&none  &none         &none         &none         &none         &none                                      &none         &none         &none         &none         &none           &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                               &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none
&none  &trans        &trans        &trans        &trans        &trans        &none        &none           &trans        &trans        &trans        &trans        &trans          &none
&none  &trans        &trans        &trans        &trans        &trans        &bootloader  &studio_unlock  &trans        &trans        &trans        &trans        &trans          &none
&none  &trans        &trans        &trans        &trans        &trans        &trans       &trans          &trans        &none         &none         &bt BT_CLR    &bt BT_CLR_ALL  &none
            >;
        };
    };
};
